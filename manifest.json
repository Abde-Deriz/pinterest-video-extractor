{
  "manifest_version": 3,
  "name": "Pinterest Video Extractor",
  "version": "0.1.0",
  "description": "Extract Pinterest video pins, export CSV, and bulk-download selected videos as a ZIP.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pin Video Extractor"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.pinimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}